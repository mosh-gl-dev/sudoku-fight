+    // [sudoku-fight patch: rate-limited synchronouslyUpdateUIProps log] Each failure was logged with Log.w and
+    // its full stack (about 80 lines). Thousands in a row (a view deleted while new views draw) kept the UI
+    // thread in printStackTrace for seconds: an ANR. Now one line without a stack, at most
+    // SYNC_UPDATE_LOG_LIMIT a second, and one line with the count of the rest when that second ends.
+    // Why: docs/PERF.md (B14) in Sudoku Fight.
+    private var syncUpdateLogWindowStart = 0L
+    private var syncUpdateLogged = 0
+    private var syncUpdateNotLogged = 0
+    private var syncUpdateCountPosted = false
+
+    @Synchronized
+    private fun logSyncUpdateFailure(
+        viewTag: Int,
+        e: Exception,
+    ) {
+        val now = SystemClock.uptimeMillis()
+        if (now - syncUpdateLogWindowStart >= SYNC_UPDATE_LOG_WINDOW_MS) {
+            logSyncUpdateNotLogged()
+            syncUpdateLogWindowStart = now
+            syncUpdateLogged = 0
+        }
+        if (syncUpdateLogged < SYNC_UPDATE_LOG_LIMIT) {
+            syncUpdateLogged++
+            val cause = (e as? java.lang.reflect.InvocationTargetException)?.targetException ?: e
+            val message = cause.message?.take(160)
+            Log.w(SYNC_UPDATE_LOG_TAG, "synchronouslyUpdateUIProps failed for tag $viewTag: ${cause.javaClass.simpleName}: $message")
+            return
+        }
+        syncUpdateNotLogged++
+        if (!syncUpdateCountPosted) {
+            syncUpdateCountPosted = true
+            val delay = (syncUpdateLogWindowStart + SYNC_UPDATE_LOG_WINDOW_MS - now).coerceAtLeast(0L)
+            UiThreadUtil.runOnUiThread(Runnable { logSyncUpdateNotLogged() }, delay)
+        }
+    }
+
+    @Synchronized
+    private fun logSyncUpdateNotLogged() {
+        syncUpdateCountPosted = false
+        if (syncUpdateNotLogged == 0) return
+        Log.w(
+            SYNC_UPDATE_LOG_TAG,
+            "synchronouslyUpdateUIProps failed $syncUpdateNotLogged more times (not logged: at most " +
+                "$SYNC_UPDATE_LOG_LIMIT lines per $SYNC_UPDATE_LOG_WINDOW_MS ms)",
+        )
+        syncUpdateNotLogged = 0
+    }
